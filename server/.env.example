# Local development (npm run dev). In Docker, DATABASE_URL is built by docker-compose from the POSTGRES_* vars.
NODE_ENV=development
PORT=8001
DATABASE_URL=postgresql://tanah:change-me@localhost:5432/tanah?schema=public
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=0
ADMIN_USER=demo
ADMIN_PASSWORD=change-me-min-8-chars
# at least 32 random chars, e.g. `openssl rand -hex 32`
ADMIN_TOKEN_SECRET=change-me-change-me-change-me-change-me
