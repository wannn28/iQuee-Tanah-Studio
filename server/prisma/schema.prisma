// Tanah Studio demo shop - PostgreSQL schema (Prisma ORM)
// Money is stored as integer cents to avoid floating point rounding.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @db.VarChar(32)
  name      String    @db.VarChar(80)
  blurb     String    @db.VarChar(200)
  image     String    @db.VarChar(80)
  sortOrder Int       @default(0) @map("sort_order")
  products  Product[]

  @@map("categories")
}

model Product {
  id             String      @id @db.VarChar(32)
  slug           String      @unique @db.VarChar(120)
  name           String      @db.VarChar(160)
  categoryId     String      @map("category_id") @db.VarChar(32)
  category       Category    @relation(fields: [categoryId], references: [id])
  priceCents     Int         @map("price_cents")
  compareAtCents Int?        @map("compare_at_cents")
  /// [{ src, alt }]
  images         Json
  short          String      @db.VarChar(300)
  /// string[] paragraphs
  description    Json
  /// string[]
  details        Json
  /// [{ name, values: [{ label, priceDelta?, image?, swatch? }] }]
  options        Json
  badge          String?     @db.VarChar(40)
  featured       Boolean     @default(false)
  addedRank      Int         @default(0) @map("added_rank")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([priceCents])
  @@map("products")
}

model PromoCode {
  code         String   @id @db.VarChar(32)
  label        String   @db.VarChar(120)
  percentOff   Int      @default(0) @map("percent_off")
  freeShipping Boolean  @default(false) @map("free_shipping")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  orders       Order[]

  @@map("promo_codes")
}

enum OrderStatus {
  PLACED
  PACKED
  SHIPPED
  CANCELLED
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  number         String      @unique @db.VarChar(20)
  /// secret used to view the confirmation page (returned once to the buyer)
  accessToken    String      @map("access_token") @db.VarChar(64)
  status         OrderStatus @default(PLACED)
  email          String      @db.VarChar(254)
  phone          String?     @db.VarChar(40)
  firstName      String      @map("first_name") @db.VarChar(80)
  lastName       String      @map("last_name") @db.VarChar(80)
  address1       String      @db.VarChar(160)
  address2       String?     @db.VarChar(160)
  city           String      @db.VarChar(80)
  region         String      @db.VarChar(80)
  postal         String      @db.VarChar(16)
  country        String      @db.VarChar(60)
  shippingMethod String      @map("shipping_method") @db.VarChar(20)
  shippingCents  Int         @map("shipping_cents")
  paymentMethod  String      @map("payment_method") @db.VarChar(20)
  paymentLabel   String      @map("payment_label") @db.VarChar(80)
  promoCode      String?     @map("promo_code") @db.VarChar(32)
  promo          PromoCode?  @relation(fields: [promoCode], references: [code])
  subtotalCents  Int         @map("subtotal_cents")
  discountCents  Int         @map("discount_cents")
  totalCents     Int         @map("total_cents")
  createdAt      DateTime    @default(now()) @map("created_at")
  items          OrderItem[]

  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        String  @map("order_id") @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String  @map("product_id") @db.VarChar(32)
  product        Product @relation(fields: [productId], references: [id])
  productName    String  @map("product_name") @db.VarChar(160)
  image          String  @db.VarChar(80)
  /// selected options { Color: "Sand", Size: "12 oz" }
  options        Json
  unitPriceCents Int     @map("unit_price_cents")
  qty            Int
  lineTotalCents Int     @map("line_total_cents")

  @@index([orderId])
  @@map("order_items")
}
