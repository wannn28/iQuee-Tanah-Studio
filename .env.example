# docker-compose settings for the shop stack. Copy to .env and replace every value. Never commit .env.
# Generate secrets with: openssl rand -hex 24
POSTGRES_USER=tanah
POSTGRES_DB=tanah
# hex only (it is embedded in the DATABASE_URL)
POSTGRES_PASSWORD=change-me
API_PORT=8001
CORS_ORIGINS=https://shop.iquee.tech
# Nginx + Cloudflare in front of the API
TRUST_PROXY=2
ADMIN_USER=demo
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_TOKEN_SECRET=change-me-at-least-32-characters-long
RUN_SEED=true
